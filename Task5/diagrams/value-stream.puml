@startuml value-stream
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor #FFFFFF
skinparam ArrowColor #333333
skinparam ArrowThickness 2
skinparam nodesep 20
skinparam ranksep 18
skinparam rectangle {
  FontColor #000000
  BorderColor #555555
  StereotypeFontColor #333333
}
skinparam rectangle<<stage>> {
  BackgroundColor #F2F2F2
  BorderColor #333333
  FontStyle bold
  FontSize 13
}
skinparam rectangle<<build>> {
  BackgroundColor #DCE8F7
  BorderColor #1F4E79
}
skinparam rectangle<<buy>> {
  BackgroundColor #E2F0D9
  BorderColor #38761D
}
skinparam rectangle<<partner>> {
  BackgroundColor #FCE5CD
  BorderColor #B45F06
}
skinparam rectangle<<cross>> {
  BackgroundColor #FFFFFF
  BorderColor #333333
  FontStyle bold
}
skinparam rectangle<<value>> {
  BackgroundColor #FFF2CC
  BorderColor #7F6000
  FontStyle bold
}
hide stereotype



skinparam rectangle<<col>> {
  BackgroundColor #FFFFFF
  BorderColor #BFBFBF
  FontSize 1
  FontColor #FFFFFF
}
title Africa Delivery — поток ценности «Покупатель получил товар, продавец — деньги в тот же день»

rectangle "<b>Продавец</b>\nхочет продавать" <<value>> as Start
rectangle " " <<col>> as COL1 {
  rectangle "1. Подключить\nпродавца" <<stage>> as S1
  rectangle "1.1 Онбординг и KYC\nBuild · Buy KYC с M6\nMVP" <<build>> as C11
  rectangle "6.3 WhatsApp продавца\nPartner 360dialog\nMVP" <<partner>> as C63
}
rectangle " " <<col>> as COL2 {
  rectangle "2. Наполнить\nвитрину" <<stage>> as S2
  rectangle "1.2 Каталог и модерация\nBuild\nMVP" <<build>> as C12
  rectangle "1.3 Цены, остатки, промо\nBuild\nMVP" <<build>> as C13
}
rectangle " " <<col>> as COL3 {
  rectangle "3. Привлечь\nпокупателя" <<stage>> as S3
  rectangle "2.2 Маркетинг с согласиями\nPartner TikTok / FB Live\nMVP" <<partner>> as C22
  rectangle "2.4 Локализация\nBuild + Buy Crowdin\nM12" <<build>> as C24
}
rectangle " " <<col>> as COL4 {
  rectangle "4. Найти\nи выбрать" <<stage>> as S4
  rectangle "6.1 Мобильное приложение\nBuild\nMVP" <<build>> as C61
  rectangle "2.1 Поиск и навигация\nBuild\nMVP" <<build>> as C21
  rectangle "2.3 Отзывы и рейтинги\nBuild\nM6" <<build>> as C23
}
rectangle " " <<col>> as COL5 {
  rectangle "5. Оформить\nи оплатить" <<stage>> as S5
  rectangle "3.1 Корзина и оформление\nBuild\nMVP" <<build>> as C31
  rectangle "6.2 USSD и SMS\nPartner Africa's Talking\nMVP" <<partner>> as C62
  rectangle "4.1 Приём платежей\nPartner FLW · Paystack · M-Pesa\nMVP" <<partner>> as C41
  rectangle "3.4 B2B-продажи\nBuild + Partner\nM12" <<build>> as C34
}
rectangle " " <<col>> as COL6 {
  rectangle "6. Доставить\nи выдать" <<stage>> as S6
  rectangle "5.1 Доставка\nPartner Sendbox · Sendy\nMVP" <<partner>> as C51
  rectangle "5.2 Пункты выдачи\nPartner, видео с M12\nMVP" <<partner>> as C52
  rectangle "5.3 Отслеживание\nBuild\nMVP → M6" <<build>> as C53
}
rectangle " " <<col>> as COL7 {
  rectangle "7. Рассчитаться\nс продавцом" <<stage>> as S7
  rectangle "4.2 Выплаты в тот же день\nPartner + Build\nMVP" <<partner>> as C42
  rectangle "4.3 Возврат денег и сверка\nBuild\nMVP" <<build>> as C43
}
rectangle " " <<col>> as COL8 {
  rectangle "8. Поддержать\nи вернуть" <<stage>> as S8
  rectangle "6.5 Поддержка\nBuild → Buy с M6\nMVP" <<buy>> as C65
  rectangle "3.3 Возвраты\nBuild + Partner\nM6" <<build>> as C33
}
rectangle "<b>Покупатель</b> получил товар\n<b>Продавец</b> получил деньги" <<value>> as Finish
rectangle "Сквозные возможности — на всех этапах" <<cross>> as X {
  rectangle "6.4 Уведомления\nBuild + Partner · MVP" <<build>> as C64
  rectangle "7.1 Идентификация (OTP)\nBuild · MVP" <<build>> as C71
  rectangle "7.2 Согласия и ПДн\nBuild · MVP" <<build>> as C72
  rectangle "7.3 Антифрод\nBuild + Partner · MVP → M12" <<build>> as C73
  rectangle "8.1–8.2 Аналитика\nBuild + Buy DWH с M6 · MVP" <<build>> as C81
  rectangle "9. Платформа\nBuy managed · MVP" <<buy>> as C9
}
legend right
  |= Цвет |= Решение |
  |<#DCE8F7>| Build — строим сами |
  |<#E2F0D9>| Buy — SaaS / managed |
  |<#FCE5CD>| Partner — лицензиат, телеком, физическая сеть |
  MVP — 15.10.2026, M6 — апрель 2027, M12 — октябрь 2027
endlegend
