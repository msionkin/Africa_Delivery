@startuml capability-map
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam backgroundColor #FFFFFF
skinparam nodesep 18
skinparam ranksep 14
skinparam rectangle {
  FontColor #000000
  BorderColor #555555
}
skinparam rectangle<<l1>> {
  BackgroundColor #F2F2F2
  BorderColor #333333
  FontStyle bold
  FontSize 14
}
skinparam rectangle<<build>> {
  BackgroundColor #DCE8F7
  BorderColor #1F4E79
}
skinparam rectangle<<buy>> {
  BackgroundColor #E2F0D9
  BorderColor #38761D
}
skinparam rectangle<<partner>> {
  BackgroundColor #FCE5CD
  BorderColor #B45F06
}
skinparam rectangle<<pad>> {
  BackgroundColor #F2F2F2
  BorderColor #F2F2F2
  FontColor #F2F2F2
}
hide stereotype
<style>
rectangle {
  MinimumWidth 260
}
</style>

title Africa Delivery — Capability Map (L1 / L2)
rectangle "1. Продавцы и ассортимент" <<l1>> as L1 {
